{
	"name": "@nakanoaas/notion-valibot-schema",
	"version": "1.0.0-rc.3",
	"description": "Turn Notion's nested API responses into clean, typed JavaScript values.",
	"keywords": [
		"notion",
		"schema",
		"valibot"
	],
	"homepage": "https://github.com/nakanoasaservice/notion-valibot-schema",
	"bugs": {
		"url": "https://github.com/nakanoasaservice/notion-valibot-schema/issues"
	},
	"license": "MIT",
	"author": "Nakano as a Service",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nakanoasaservice/notion-valibot-schema.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vp pack",
		"check:fix": "vp check --fix",
		"check": "vp check",
		"test": "vp test --typecheck",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@notionhq/client": "^5.6.0",
		"@types/node": "^25.9.2",
		"typescript": "^6.0.3",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"valibot": "^1.2.0"
	},
	"packageManager": "pnpm@10.23.0"
}
